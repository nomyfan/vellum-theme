{
  "name": "Vellum Light",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "method": "#8E6C00",
    "function": "#8E6C00",
    "class": "#4F6E5B",
    "variable": "#45413D",
    "property": "#45413D",
    "variable.readonly": "#975F87"
  },
  "colors": {
    "activityBar.background": "#EBE5DE",
    "activityBar.foreground": "#45413D",
    "activityBarBadge.background": "#B05918",
    "activityBarBadge.foreground": "#FFFFFF",
    "button.background": "#B05918",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#9A4E15",
    "debugToolBar.background": "#EBE5DE",
    "debugToolBar.border": "#B8B2AA",
    "editor.background": "#FAF8F5",
    "editor.foreground": "#45413D",
    "editor.lineHighlightBackground": "#F0EBE4",
    "editor.selectionBackground": "#D5CBC2",
    "editorCursor.foreground": "#B05918",
    "editorIndentGuide.background": "#EBE5DE",
    "editorIndentGuide.activeBackground": "#B8B2AA",
    "editorGroupHeader.tabsBackground": "#F2EFEC",
    "editorLineNumber.foreground": "#A49E97",
    "editorLineNumber.activeForeground": "#45413D",
    "editorWhitespace.foreground": "#EBE5DE",
    "editorHoverWidget.background": "#EBE5DE",
    "editorHoverWidget.border": "#B8B2AA",
    "editorWidget.background": "#EBE5DE",
    "editorWidget.border": "#B8B2AA",
    "scrollbar.shadow": "#00000000",
    "focusBorder": "#B05918",
    "editorBracketHighlight.foreground1": "#8E6C00",
    "editorBracketHighlight.foreground2": "#975F87",
    "editorBracketHighlight.foreground3": "#4F6E5B",
    "editorBracketHighlight.foreground4": "#B05918",
    "editorBracketHighlight.foreground5": "#507C39",
    "editorBracketHighlight.foreground6": "#78716A",
    "editorBracketHighlight.unexpectedBracket.foreground": "#B75051",
    "input.background": "#FAF8F5",
    "input.foreground": "#45413D",
    "input.border": "#B8B2AA",
    "inputOption.activeBorder": "#B05918",
    "inputOption.activeBackground": "#E8E0D6",
    "inputOption.activeForeground": "#B05918",
    "notifications.background": "#EBE5DE",
    "notifications.foreground": "#45413D",
    "notifications.border": "#B8B2AA",
    "panel.background": "#EBE5DE",
    "panel.border": "#B8B2AA",
    "peekView.border": "#B8B2AA",
    "peekViewEditor.background": "#F2EFEC",
    "peekViewResult.background": "#EBE5DE",
    "peekViewResult.selectionBackground": "#E0D6CC",
    "peekViewTitle.background": "#EBE5DE",
    "sideBar.background": "#F2EFEC",
    "sideBar.foreground": "#45413D",
    "sideBarSectionHeader.background": "#EBE5DE",
    "statusBar.background": "#EBE5DE",
    "statusBar.foreground": "#45413D",
    "statusBar.noFolderBackground": "#EBE5DE",
    "statusBar.noFolderForeground": "#45413D",
    "statusBar.debuggingBackground": "#B05918",
    "tab.activeBackground": "#FAF8F5",
    "tab.activeForeground": "#B05918",
    "tab.activeBorderTop": "#B05918",
    "tab.inactiveBackground": "#F2EFEC",
    "tab.inactiveForeground": "#8A837B",
    "titleBar.activeBackground": "#F2EFEC",
    "titleBar.activeForeground": "#45413D",
    "list.activeSelectionBackground": "#E0D6CC",
    "list.activeSelectionForeground": "#45413D",
    "list.inactiveSelectionBackground": "#E8E0D6",
    "list.focusBackground": "#E0D6CC",
    "list.hoverBackground": "#F0EBE4",
    "pickerGroup.border": "#EBE5DE",
    "pickerGroup.foreground": "#B05918",
    "quickInput.background": "#EBE5DE",
    "quickInput.foreground": "#45413D",
    "quickInputList.focusBackground": "#E0D6CC",
    "terminal.background": "#FAF8F5",
    "terminal.foreground": "#45413D",
    "textLink.foreground": "#B05918",
    "textLink.activeForeground": "#9A4E15"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#8A837B",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "variable.language",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B05918",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#8E6C00",
        "fontStyle": ""
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#507C39"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#975F87"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other",
        "variable.object.property"
      ],
      "settings": {
        "foreground": "#45413D",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#4F6E5B",
        "fontStyle": ""
      }
    },
    {
      "scope": ["entity.name.tag", "meta.tag.sgml", "markup.deleted"],
      "settings": {
        "foreground": "#B75051",
        "fontStyle": ""
      }
    },
    {
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": {
        "foreground": "#78716A"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "entity.name.tag.yaml",
        "entity.name.section.toml"
      ],
      "settings": {
        "foreground": "#45413D",
        "fontStyle": ""
      }
    },
    {
      "scope": ["variable.other.constant", "variable.other.enummember"],
      "settings": {
        "foreground": "#975F87"
      }
    },
    {
      "scope": ["entity.name.lifetime.rust"],
      "settings": {
        "foreground": "#B05918",
        "fontStyle": ""
      }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#B05918",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
