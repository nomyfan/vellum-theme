{
  "name": "Vellum Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "method": "#DBBC7F",
    "function": "#DBBC7F",
    "class": "#8FA895",
    "variable": "#D8D3CB",
    "property": "#D8D3CB",
    "variable.readonly": "#D699B6"
  },
  "colors": {
    "activityBar.background": "#1A1816",
    "activityBar.foreground": "#D8D3CB",
    "activityBarBadge.background": "#E6A67E",
    "activityBarBadge.foreground": "#1A1816",
    "button.background": "#E6A67E",
    "button.foreground": "#1A1816",
    "button.hoverBackground": "#D9956C",
    "debugToolBar.background": "#201E1B",
    "debugToolBar.border": "#2A2723",
    "editor.background": "#1A1816",
    "editor.foreground": "#D8D3CB",
    "editor.lineHighlightBackground": "#24221F",
    "editor.selectionBackground": "#413B35",
    "editorCursor.foreground": "#E6A67E",
    "editorIndentGuide.background": "#2A2723",
    "editorIndentGuide.activeBackground": "#5C5650",
    "editorGroupHeader.tabsBackground": "#151311",
    "editorLineNumber.foreground": "#5C5650",
    "editorLineNumber.activeForeground": "#D8D3CB",
    "editorWhitespace.foreground": "#2A2723",
    "editorHoverWidget.background": "#201E1B",
    "editorHoverWidget.border": "#2A2723",
    "editorWidget.background": "#201E1B",
    "editorWidget.border": "#2A2723",
    "scrollbar.shadow": "#00000000",
    "focusBorder": "#E6A67E",
    "editorBracketHighlight.foreground1": "#DBBC7F",
    "editorBracketHighlight.foreground2": "#D699B6",
    "editorBracketHighlight.foreground3": "#8FA895",
    "editorBracketHighlight.foreground4": "#E6A67E",
    "editorBracketHighlight.foreground5": "#A6C485",
    "editorBracketHighlight.foreground6": "#9D9790",
    "editorBracketHighlight.unexpectedBracket.foreground": "#E68585",
    "input.background": "#151311",
    "input.foreground": "#D8D3CB",
    "input.border": "#2A2723",
    "inputOption.activeBorder": "#E6A67E",
    "inputOption.activeBackground": "#2C2925",
    "inputOption.activeForeground": "#E6A67E",
    "notifications.background": "#201E1B",
    "notifications.foreground": "#D8D3CB",
    "notifications.border": "#2A2723",
    "panel.background": "#201E1B",
    "panel.border": "#2A2723",
    "peekView.border": "#2A2723",
    "peekViewEditor.background": "#151311",
    "peekViewResult.background": "#201E1B",
    "peekViewResult.selectionBackground": "#413B35",
    "peekViewTitle.background": "#201E1B",
    "sideBar.background": "#151311",
    "sideBar.foreground": "#D8D3CB",
    "sideBarSectionHeader.background": "#201E1B",
    "statusBar.background": "#201E1B",
    "statusBar.foreground": "#D8D3CB",
    "statusBar.noFolderBackground": "#201E1B",
    "statusBar.noFolderForeground": "#D8D3CB",
    "statusBar.debuggingBackground": "#E6A67E",
    "tab.activeBackground": "#1A1816",
    "tab.activeForeground": "#E6A67E",
    "tab.activeBorderTop": "#E6A67E",
    "tab.inactiveBackground": "#151311",
    "tab.inactiveForeground": "#7C7670",
    "titleBar.activeBackground": "#151311",
    "titleBar.activeForeground": "#D8D3CB",
    "list.activeSelectionBackground": "#413B35",
    "list.activeSelectionForeground": "#D8D3CB",
    "list.inactiveSelectionBackground": "#2C2925",
    "list.focusBackground": "#413B35",
    "list.hoverBackground": "#24221F",
    "pickerGroup.border": "#2A2723",
    "pickerGroup.foreground": "#E6A67E",
    "quickInput.background": "#201E1B",
    "quickInput.foreground": "#D8D3CB",
    "quickInputList.focusBackground": "#413B35",
    "terminal.background": "#1A1816",
    "terminal.foreground": "#D8D3CB",
    "textLink.foreground": "#E6A67E",
    "textLink.activeForeground": "#DBBC7F"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#7C7670",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "variable.language",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E6A67E",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#DBBC7F",
        "fontStyle": ""
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#A6C485"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#D699B6"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other",
        "variable.object.property"
      ],
      "settings": {
        "foreground": "#D8D3CB",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8FA895",
        "fontStyle": ""
      }
    },
    {
      "scope": ["entity.name.tag", "meta.tag.sgml", "markup.deleted"],
      "settings": {
        "foreground": "#E68585",
        "fontStyle": ""
      }
    },
    {
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": {
        "foreground": "#9D9790"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "entity.name.tag.yaml",
        "entity.name.section.toml"
      ],
      "settings": {
        "foreground": "#D8D3CB",
        "fontStyle": ""
      }
    },
    {
      "scope": ["variable.other.constant", "variable.other.enummember"],
      "settings": {
        "foreground": "#D699B6"
      }
    },
    {
      "scope": ["entity.name.lifetime.rust"],
      "settings": {
        "foreground": "#E6A67E",
        "fontStyle": ""
      }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#E6A67E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
